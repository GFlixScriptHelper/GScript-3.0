local function makeSwitchCard(labelText, cardPos)
	local card = make("Frame", {
		BackgroundColor3 = NAVY,
		BorderSizePixel = 0,
		Position = cardPos,
		Size = UDim2.new(0.083988, 0, 0.37851, 0),
	}, content)
	corner(card)
	stroke(card, NAVY_STROKE, 1)

	local switch = make("TextButton", {
		BackgroundColor3 = SWITCH_OFF,
		BorderSizePixel = 0,
		Position = UDim2.new(0.62915, -42, 0.64814, -9),
		Size = UDim2.new(0, 50, 0, 30),
		Text = "",
		AutoButtonColor = false,
	}, card)
	corner(switch, 15)
	stroke(switch, BTN_STROKE, 1)

	local knob = make("Frame", {
		BackgroundColor3 = KNOB_OFF,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 3, 0.5, -6),
		Size = UDim2.new(0, 12, 0, 12),
	}, switch)
	corner(knob, 6)

	make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 10),
		Size = UDim2.new(1.2646, -58, 0.41977, 0),
		FontFace = FONT,
		Text = labelText,
		TextColor3 = LABEL_TEXT,
		TextScaled = true,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local function setState(on)
		TweenService:Create(switch, TWEEN, {
			BackgroundColor3 = on and SWITCH_ON or SWITCH_OFF,
		}):Play()
		TweenService:Create(knob, TWEEN, {
			Position = on and UDim2.new(0, 35, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
			BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or KNOB_OFF,
		}):Play()
	end

	return switch, setState
end

