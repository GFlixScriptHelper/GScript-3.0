-- ============================================================
--  LOGIC
-- ============================================================
local DEFAULT_SIZE, THICKNESS = 10, 0.5 -- every platform is DEFAULT_SIZE x THICKNESS x DEFAULT_SIZE
local MIN_SIZE, MAX_SIZE = 1, 500
local MAX_LIFT = 500                     -- "Height" can go from -MAX_LIFT to +MAX_LIFT studs
local STEP_SIZE, STEP_HEIGHT = 1, 1      -- how much -1 / +1 (or , and .) change each mode

local MATERIALS = {
	Enum.Material.SmoothPlastic, Enum.Material.Plastic, Enum.Material.Neon,
	Enum.Material.Wood, Enum.Material.WoodPlanks, Enum.Material.Metal,
	Enum.Material.DiamondPlate, Enum.Material.Glass, Enum.Material.Ice,
	Enum.Material.Grass, Enum.Material.Concrete, Enum.Material.Brick,
	Enum.Material.Marble, Enum.Material.Granite, Enum.Material.ForceField,
}

local platforms = {}      -- { part, button, materialIndex }
local selected = nil
local mode = "Size"       -- "Size" or "Height"
local following = false
local adding = false      -- placement mode (Add Part switch is ON)
local counter = 0

-- always a fresh folder, removed on destroy
local folder = Instance.new("Folder")
folder.Name = "GScript_Platforms"
folder.Parent = workspace

-- outlines the selected platform so you can always see which one it is
local selectionBox = Instance.new("SelectionBox")
selectionBox.Color3 = Color3.fromRGB(57, 87, 255)
selectionBox.SurfaceColor3 = Color3.fromRGB(57, 87, 255)
selectionBox.SurfaceTransparency = 0.8
selectionBox.LineThickness = 0.15
selectionBox.Parent = folder

-- 10 -> "10", 0.5 -> "0.5", 1.25 -> "1.3"
local function fmt(v)
	return ("%g"):format(math.floor(v * 10 + 0.5) / 10)
end

local function getRoot()
	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hrp, hum
end

-- distance from the root part down to the feet
local function feetOffset(hrp, hum)
	if hum and hum.RigType == Enum.HumanoidRigType.R6 then
		return 3
	end
	return (hum and hum.HipHeight or 2) + hrp.Size.Y / 2
end

local function updateInfo()
	local part = selected and selected.part
	local size = part and part.Size.X or DEFAULT_SIZE
	-- Height = how many studs the platform is raised (+) or lowered (-) from where it was placed
	local height = part and (part.Position.Y - selected.baseY) or 0
	infoLabel.Text = ("Size: %s  |  Height: %s"):format(fmt(size), fmt(height))
	modeButton.Text = (mode == "Size") and "S" or "H"
	local step = fmt((mode == "Size") and STEP_SIZE or STEP_HEIGHT)
	minusButton.Text = "< -" .. step
	plusButton.Text = "+" .. step .. " >"
	textureButton.Text = "Texture: " .. (part and part.Material.Name or MATERIALS[1].Name)
end

-- shows a short message in the info box, then goes back to the size readout
local flashToken = 0
local function flash(text)
	flashToken = flashToken + 1
	local mine = flashToken
	infoLabel.Text = text
	task.delay(1.5, function()
		if flashToken == mine then
			updateInfo()
		end
	end)
end

local function selectPlatform(entry)
	selected = entry
	selectionBox.Adornee = entry and entry.part or nil
	for _, e in ipairs(platforms) do
		local ring = e.button:FindFirstChild("Selected")
		if ring then
			ring.Enabled = (e == entry)
		end
	end
	updateInfo()
end

local function addPlatform(position)
	counter = counter + 1

	local part = Instance.new("Part")
	part.Name = "Platform" .. counter
	part.Anchored = true
	part.CanCollide = true
	part.Material = MATERIALS[1]
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(DEFAULT_SIZE, THICKNESS, DEFAULT_SIZE)
	part.Position = position + Vector3.new(0, THICKNESS / 2, 0) -- sits on top of the clicked point
	part.Parent = folder

	local button = template:Clone()
	button.Name = "Platform" .. counter
	button.Text = "Platform " .. counter
	button.LayoutOrder = counter
	button.Visible = true
	-- careful: TextButton has its own boolean property called "Selected", so
	-- button.Selected is that boolean and NOT the UIStroke child. Use FindFirstChild.
	local ring = button:FindFirstChild("Selected")
	if ring then
		ring.Enabled = false
	end
	button.Parent = listFrame

	local entry = { part = part, button = button, materialIndex = 1, baseY = part.Position.Y }
	table.insert(platforms, entry)

	button.MouseButton1Click:Connect(function()
		selectPlatform(entry)
	end)

	selectPlatform(entry)
end

local function deleteSelected()
	if not selected then
		flash("Select a part first")
		return
	end
	local entry = selected
	for i, e in ipairs(platforms) do
		if e == entry then
			table.remove(platforms, i)
			break
		end
	end
	entry.part:Destroy()
	entry.button:Destroy()
	selectPlatform(platforms[#platforms]) -- nil when the list is empty
end

-- changes Size (X and Z together) or Height by delta
local function adjust(delta)
	if not selected then
		flash("Select a part first")
		return
	end
	local part = selected.part
	local size = part.Size
	if mode == "Size" then
		local n = math.clamp(size.X + delta * STEP_SIZE, MIN_SIZE, MAX_SIZE)
		part.Size = Vector3.new(n, size.Y, n)
	else
		-- Height: raise / lower the whole platform (thickness never changes)
		local lift = part.Position.Y - selected.baseY + delta * STEP_HEIGHT
		lift = math.clamp(lift, -MAX_LIFT, MAX_LIFT)
		part.Position = Vector3.new(part.Position.X, selected.baseY + lift, part.Position.Z)
	end
	updateInfo()
end

local function resetSize()
	if not selected then
		flash("Select a part first")
		return
	end
	local part = selected.part
	part.Size = Vector3.new(DEFAULT_SIZE, THICKNESS, DEFAULT_SIZE)
	updateInfo()
end

local function randomColor()
	if not selected then
		flash("Select a part first")
		return
	end
	selected.part.Color = Color3.fromHSV(math.random(), 0.6, 1)
end

local function cycleTexture()
	if not selected then
		flash("Select a part first")
		return
	end
	selected.materialIndex = (selected.materialIndex % #MATERIALS) + 1
	selected.part.Material = MATERIALS[selected.materialIndex]
	updateInfo()
end

local function teleportToSelected()
	if not selected then
		flash("Select a part first")
		return
	end
	local hrp, hum = getRoot()
	if not hrp then
		flash("No character found")
		return
	end
	local part = selected.part
	local topY = part.Position.Y + part.Size.Y / 2
	local target = Vector3.new(part.Position.X, topY + feetOffset(hrp, hum) + 0.5, part.Position.Z)
	hrp.CFrame = CFrame.new(target) * (hrp.CFrame - hrp.CFrame.Position) -- keeps the way you're facing
end

-- ============================================================
--  EVENTS
-- ============================================================
-- Add Part: turn the switch ON, then click anywhere in the world to drop a platform there.
-- It stays on so you can place several; turn it off to stop.
local function isOverGui(pos)
	-- ignore clicks that land on the GScript3 menu itself
	for _, child in ipairs(API.Gui:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible and child.Name ~= "ConfettiHolder" then
			local p, s = child.AbsolutePosition, child.AbsoluteSize
			if pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y then
				return true
			end
		end
	end
	return false
end

local function placeAt(screenPos)
	local camera = workspace.CurrentCamera
	if not camera then return end

	local ray = camera:ViewportPointToRay(screenPos.X, screenPos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { localPlayer.Character } -- so you don't click yourself

	local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	-- clicking the sky places it 100 studs out along the ray
	local position = result and result.Position or (ray.Origin + ray.Direction * 100)
	addPlatform(position)
end

addSwitch.MouseButton1Click:Connect(function()
	adding = not adding
	setAddState(adding)
	if adding then
		flash("Click in the world to place a part")
	end
end)

API.Track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not adding then return end

	local screenPos
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		screenPos = UserInputService:GetMouseLocation()
	elseif input.UserInputType == Enum.UserInputType.Touch then
		screenPos = Vector2.new(input.Position.X, input.Position.Y)
	else
		return
	end

	if isOverGui(screenPos) then return end
	placeAt(screenPos)
end))

-- Follow Part: the selected part follows you (X/Z), keeping its own height
followSwitch.MouseButton1Click:Connect(function()
	following = not following
	setFollowState(following)
	if following and not selected then
		flash("Select a part first")
	end
end)

minusButton.MouseButton1Click:Connect(function() press(minusButton); adjust(-1) end)
plusButton.MouseButton1Click:Connect(function() press(plusButton); adjust(1) end)

modeButton.MouseButton1Click:Connect(function()
	press(modeButton)
	mode = (mode == "Size") and "Height" or "Size"
	updateInfo()
end)

deleteButton.MouseButton1Click:Connect(function() press(deleteButton); deleteSelected() end)
resetButton.MouseButton1Click:Connect(function() press(resetButton); resetSize() end)
colorButton.MouseButton1Click:Connect(function() press(colorButton); randomColor() end)
textureButton.MouseButton1Click:Connect(function() press(textureButton); cycleTexture() end)
teleportButton.MouseButton1Click:Connect(function() press(teleportButton); teleportToSelected() end)

-- keybinds: "," = decrease, "." = increase (Size or Height, depending on the S/H button)
API.Track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.Comma then
		adjust(-1)
	elseif input.KeyCode == Enum.KeyCode.Period then
		adjust(1)
	end
end))

-- Follow Part loop
API.Track(RunService.Heartbeat:Connect(function()
	if not following or not selected then return end
	local hrp = getRoot()
	if not hrp then return end
	local part = selected.part
	part.Position = Vector3.new(hrp.Position.X, part.Position.Y, hrp.Position.Z)
end))

-- cleanup when GScript3 is destroyed / re-run
API.OnDestroy(function()
	pcall(function() folder:Destroy() end)
end)

updateInfo()
