-- creates an instance, sets its properties, then parents it
local function make(class, props, parent)
	local inst = Instance.new(class)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, parent)
end

local function stroke(parent, color, thickness, border)
	return make("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		ApplyStrokeMode = border and Enum.ApplyStrokeMode.Border or Enum.ApplyStrokeMode.Contextual,
	}, parent)
end

local TWEEN = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- ============================================================
--  PANEL
--  Your design was made at about 1243 x 179 pixels, so everything lives in a
--  "Content" frame of that size and a UIScale stretches it to fit the panel.
--  That keeps your exact layout at any screen size.
-- ============================================================
local REF_W, REF_H = 1243, 179

local panel = API.AddTab("Platform", {
	Size = UDim2.new(0.99476, 0, 0.45586, 0),
	AspectRatio = 6.94,
	Position = UDim2.new(0.0024799, 0, 0.071429, 0),
})

local content = make("Frame", {
	Name = "Content",
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Size = UDim2.fromOffset(REF_W, REF_H),
}, panel)

local uiScale = make("UIScale", {}, content)

local function fitScale()
	uiScale.Scale = math.max(panel.AbsoluteSize.X / REF_W, 0.05)
end
fitScale()
panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitScale)

