local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(90, 220, 120),
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(200, 110, 255),
	Color3.fromRGB(255, 130, 200),
}

local rng = Random.new()

local function PlayConfetti(amount)
	for _ = 1, amount do
		task.spawn(function()
			local piece = Instance.new("Frame")
			piece.AnchorPoint = Vector2.new(0.5, 0.5)
			piece.BackgroundColor3 = CONFETTI_COLORS[rng:NextInteger(1, #CONFETTI_COLORS)]
			piece.BorderSizePixel = 0
			piece.Size = UDim2.new(0, rng:NextInteger(6, 10), 0, rng:NextInteger(10, 16))
			piece.Position = UDim2.new(0.5, 0, 0.5, 0)
			piece.Rotation = rng:NextInteger(0, 360)
			piece.ZIndex = 1
			piece.Parent = ConfettiHolder

			-- burst outward and up
			local burstX = 0.5 + rng:NextNumber(-0.55, 0.55)
			local burstY = 0.5 - rng:NextNumber(0.1, 0.5)
			local burst = TweenService:Create(
				piece,
				TweenInfo.new(rng:NextNumber(0.5, 0.8), Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{
					Position = UDim2.new(burstX, 0, burstY, 0),
					Rotation = piece.Rotation + rng:NextInteger(-360, 360),
				}
			)
			burst:Play()
			burst.Completed:Wait()

			-- fall down and fade
			local fall = TweenService:Create(
				piece,
				TweenInfo.new(rng:NextNumber(1.2, 1.8), Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{
					Position = UDim2.new(burstX + rng:NextNumber(-0.1, 0.1), 0, 1.15, 0),
					Rotation = piece.Rotation + rng:NextInteger(-540, 540),
					BackgroundTransparency = 1,
				}
			)
			fall:Play()
			fall.Completed:Wait()
			piece:Destroy()
		end)
	end
end

local function PlayCompleteSound()
	local sound = Instance.new("Sound")
	sound.SoundId = SOUND_ID
	sound.Volume = SOUND_VOLUME
	sound.Parent = game:GetService("SoundService") -- so it isn't cut off when the GUI is destroyed
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	game:GetService("Debris"):AddItem(sound, 15)
end

----------------------------------------------------------------
-- Panels. Only one panel is open at a time.
-- Clicking a tab opens its panel, clicking it again closes it,
-- clicking another tab swaps between them.
----------------------------------------------------------------
local menuInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local panels = {
	Menu = {
		frame = Menu_23,
		shown = PANEL_POS,
		hidden = UDim2.new(PANEL_POS.X.Scale, PANEL_POS.X.Offset, -0.6, 0),
	},
}
local activePanel = nil
local panelBusy = false

local function SetPanel(name)
	if panelBusy then return end
	if name == activePanel then
		name = nil -- clicking the open tab closes it
	end
	panelBusy = true

	local last
	if activePanel then
		local p = panels[activePanel]
		last = TweenService:Create(p.frame, menuInfo, { Position = p.hidden })
		last:Play()
	end
	if name then
		local p = panels[name]
		last = TweenService:Create(p.frame, menuInfo, { Position = p.shown })
		last:Play()
	end
	if last then
		last.Completed:Wait()
	end

	activePanel = name
	panelBusy = false
end

local function ClosePanels()
	if not activePanel or panelBusy then return end
	SetPanel(activePanel) -- same name = close
end

Menu_16.Activated:Connect(function()
	SetPanel("Menu")
end)

-- Menu bar open / close (Closebutton moves it up, OpenMenu brings it back down)
local MENU_HIDDEN_POS = UDim2.new(MENU_POS.X.Scale, 0, -0.15, 0)
local menuOpen = false
local menuBusy = false

local function ShowMenu()
	if menuOpen or menuBusy then return end
	menuBusy = true
	local t = TweenService:Create(OfficialMenu_8, menuInfo, { Position = MENU_POS })
	t:Play()
	t.Completed:Wait()
	menuOpen = true
	menuBusy = false
end

local function HideMenu()
	if not menuOpen or menuBusy then return end
	menuBusy = true
	task.spawn(ClosePanels) -- the open panel goes up together with the bar
	local t = TweenService:Create(OfficialMenu_8, menuInfo, { Position = MENU_HIDDEN_POS })
	t:Play()
	t.Completed:Wait()
	menuOpen = false
	menuBusy = false
end

