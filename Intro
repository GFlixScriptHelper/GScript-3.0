----------------------------------------------------------------
-- Shared API for the tab modules
--   GScript3.AddTab(name, opts) -> panel Frame (already styled, starts hidden)
--       opts.Size, opts.Position (UDim2), opts.AspectRatio (number)
--   GScript3.SetChecker(key, status, kind)   kind = "ok" | "soon" | "fail"
--   GScript3.Track(connection)               disconnected when the GUI is destroyed
--   GScript3.OnDestroy(function)             runs when the GUI is destroyed
----------------------------------------------------------------
local API = {
	Version = "3.0 BETA",
	Gui = GScript3_1,
}

local trackedConnections = {}
local destroyHandlers = {}
local tabCount = 0

function API.Track(connection)
	table.insert(trackedConnections, connection)
	return connection
end

function API.OnDestroy(fn)
	table.insert(destroyHandlers, fn)
end

function API.SetChecker(key, status, kind)
	SetChecker(key, status, kind)
end

function API.AddTab(name, opts)
	assert(not panels[name], "GScript3: tab '" .. tostring(name) .. "' already exists")
	opts = opts or {}
	tabCount = tabCount + 1

	local shown = opts.Position or PANEL_POS
	local hidden = UDim2.new(shown.X.Scale, shown.X.Offset, -0.6, 0)

	-- tab button (same look as the Menu tab)
	local tabButton = Menu_16:Clone()
	tabButton.Name = name
	tabButton.Text = name
	tabButton.LayoutOrder = 10 + tabCount
	tabButton.Parent = Tabbers_14

	-- panel (same look as the Menu frame)
	local frame = Instance.new("Frame")
	frame.Name = name .. "Panel"
	frame.ZIndex = 5
	frame.Active = false
	frame.BackgroundColor3 = Color3.fromRGB(255, 247, 239)
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.Selectable = false
	frame.Size = opts.Size or UDim2.new(0.47523, 0, 0.46311, 0)
	frame.Position = hidden
	frame.Parent = GScript3_1

	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.AspectRatio = opts.AspectRatio or 2
	ratio.Parent = frame

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(48, 48, 48)),
		ColorSequenceKeypoint.new(0.64187, Color3.fromRGB(15, 15, 15)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(125, 71, 10)),
	})
	gradient.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = frame

	panels[name] = { frame = frame, shown = shown, hidden = hidden }

	tabButton.Activated:Connect(function()
		SetPanel(name)
	end)

	return frame
end

Env.GScript3 = API

GScript3_1.Destroying:Connect(function()
	for _, c in ipairs(trackedConnections) do
		pcall(function() c:Disconnect() end)
	end
	for _, fn in ipairs(destroyHandlers) do
		pcall(fn)
	end
	if Env.GScript3 == API then
		Env.GScript3 = nil
	end
end)

----------------------------------------------------------------
-- Fade out the intro, then slide the OfficialMenu down and enable OpenMenu
----------------------------------------------------------------
local function FadeOutAll()
	if isClosing then return end
	isClosing = true

	local outInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	TweenService:Create(LoadingBar, outInfo, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(LoadingBackground, outInfo, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(Logo_6, outInfo, { ImageTransparency = 1 }):Play()
	TweenService:Create(UIStroke_4, outInfo, { Transparency = 1 }):Play()

	local last = TweenService:Create(MainFrame_2, outInfo, { BackgroundTransparency = 1 })
	last:Play()
	last.Completed:Wait()

	-- remove the intro pieces (confetti keeps falling a bit, then gets cleaned up)
	MainFrame_2:Destroy()
	task.delay(2, function()
		ConfettiHolder:Destroy()
	end)

	-- OfficialMenu moves down to its original position
	ShowMenu()

	-- OpenMenu is now enabled (sits behind OfficialMenu)
	OpenMenu_21.Visible = true
	OpenMenu_21.Interactable = true
end

-- SetProgress(alpha): alpha is 0 to 1. When it reaches 1 the GUI fades out.
local function SetProgress(alpha)
	if isClosing then return end
	alpha = math.clamp(alpha, 0, 1)

	local fill = TweenService:Create(
		LoadingBar,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.new(alpha, 0, 1, 0) }
	)
	fill:Play()
	fill.Completed:Wait()

	if alpha >= 1 then
		PlayCompleteSound()
		PlayConfetti(70)
		task.wait(1.2) -- let the confetti burst show before fading out
		FadeOutAll()
	end
end

----------------------------------------------------------------
-- Load the modules (each one adds its own tab), updating the Checkers
----------------------------------------------------------------
local function fetchModule(file)
	if PREFER_LOCAL and readfile and isfile and isfile(LOCAL_FOLDER .. file) then
		return readfile(LOCAL_FOLDER .. file)
	end
	return game:HttpGet(BASE_URL .. file .. "?t=" .. os.time())
end

for i, module in ipairs(MODULES) do
	task.wait(0.3)
	if module.file then
		local ok, err = pcall(function()
			local fn, compileError = loadstring(fetchModule(module.file))
			if not fn then
				error(compileError, 0)
			end
			fn()
		end)
		if ok then
			SetChecker(module.key, "LOADED", "ok")
		else
			warn("[GScript3] " .. module.key .. " failed to load: " .. tostring(err))
			SetChecker(module.key, "FAILED", "fail")
		end
	else
		SetChecker(module.key, "SOON", "soon")
	end
	SetProgress(i / #MODULES)
end
