-- ============================================================
--  HEARTBEAT (rainbow / squirm / holiday anims + stale check)
-- ============================================================
local lastCheck = 0
local function checkEntries(list)
	for _, e in ipairs(list) do
		if e.enabled then
			local alive = 0
			for _, h in ipairs(e.highlights) do if h and h.Parent then alive = alive + 1 end end
			if alive == 0 then applyEntry(e) end
		end
	end
end

API.Track(RunService.Heartbeat:Connect(function(dt)
	rainbowTime = (rainbowTime + dt * 1.5) % 1
	squirmTime  = (squirmTime  + dt * 1.2) % 1
	local pulse = math.abs(math.sin(squirmTime * math.pi))

	if #rainbowRegistry > 0 then
		local col = Color3.fromHSV(rainbowTime, 1, 1)
		for _, hl in ipairs(rainbowRegistry) do
			pcall(function() hl.FillColor = col; hl.OutlineColor = col end)
		end
	end

	if #squirmRegistry > 0 then
		local col = Color3.fromRGB(255, 140, 0):Lerp(Color3.fromRGB(255, 255, 255), pulse)
		for _, hl in ipairs(squirmRegistry) do
			pcall(function() hl.FillColor = col; hl.OutlineColor = col end)
		end
	end

	local pinkPulse = Color3.fromRGB(255, 105, 180):Lerp(Color3.fromRGB(255, 255, 255), pulse)
	if #holidayRegistry > 0 then
		for _, hl in ipairs(holidayRegistry) do
			pcall(function() hl.FillColor = pinkPulse; hl.OutlineColor = pinkPulse end)
		end
	end
	if holidayPill then holidayPill.BackgroundColor3 = pinkPulse end

	lastCheck = lastCheck + dt
	if lastCheck < 2 then return end
	lastCheck = 0
	if not currentMap then return end
	checkEntries(ITEM_ENTRIES)
	checkEntries(CURRENCY_ENTRIES)
	checkEntries({ MONSTER_ENTRY })
end))

