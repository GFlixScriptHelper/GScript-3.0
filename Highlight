local function removeFromRegistry(registry, hl)
	for i = #registry, 1, -1 do
		if registry[i] == hl then table.remove(registry, i); break end
	end
end

local function clearEntry(e)
	for _, h in ipairs(e.highlights) do
		pcall(function() h:Destroy() end)
		removeFromRegistry(rainbowRegistry, h)
		removeFromRegistry(squirmRegistry, h)
		removeFromRegistry(holidayRegistry, h)
	end
	e.highlights = {}
	if e.labelBBs then
		for _, bb in ipairs(e.labelBBs) do pcall(function() bb:Destroy() end) end
		e.labelBBs = {}
	end
	if e.match  == "ResearchCapsule" then clearResearchLabels() end
	if e.folder == "Generators"      then clearGeneratorBillboards() end
end

local function applyEntry(e)
	clearEntry(e)
	if not e.enabled or not currentMap then return end
	local folderName = e.folder or "Items"
	local folder     = currentMap:FindFirstChild(folderName)
	if not folder then return end

	for _, obj in ipairs(folder:GetChildren()) do
		local matched
		if e.match == nil then
			matched = true
		elseif e.match:sub(1, 1) == "^" then
			matched = obj.Name:match(e.match) ~= nil
		else
			matched = obj.Name:lower():find(e.match:lower()) ~= nil
		end
		if matched then
			local hl = Instance.new("Highlight")
			hl.FillTransparency = 0.5; hl.OutlineTransparency = 0

			if folderName == "Monsters" and isSquirm(obj.Name) then
				hl.FillColor = Color3.fromRGB(255, 140, 0); hl.OutlineColor = Color3.fromRGB(255, 140, 0)
				table.insert(squirmRegistry, hl)
			elseif folderName == "Monsters" and isRainbow(obj.Name) then
				hl.FillColor = Color3.fromRGB(255, 0, 0); hl.OutlineColor = Color3.fromRGB(255, 0, 0)
				table.insert(rainbowRegistry, hl)
			elseif e.match == "HolidayCollectibleItem" then
				hl.FillColor = Color3.fromRGB(255, 105, 180); hl.OutlineColor = Color3.fromRGB(255, 105, 180)
				table.insert(holidayRegistry, hl)
			elseif folderName == "Generators" then
				local stats  = obj:FindFirstChild("Stats")
				local curVal = stats and stats:FindFirstChild("CurrentAmount")
				local reqVal = stats and stats:FindFirstChild("RequiredAmount")
				hl.FillColor = Color3.fromRGB(255, 255, 255); hl.FillTransparency = 0.6
				hl.OutlineColor = getGenColor(
					curVal and curVal.Value or 0,
					reqVal and reqVal.Value or 1)
			else
				hl.FillColor = e.color; hl.OutlineColor = e.color
			end

			hl.Adornee = obj; hl.Parent = hlFolder
			table.insert(e.highlights, hl)
			if e.match == "ResearchCapsule" then addResearchLabel(obj) end
			if folderName == "Generators"   then addGeneratorBillboard(obj, hl) end
			if e.showLabel then
				local text = e.displayName or e.label
				local bb   = addItemLabel(obj, text, e.color)
				if e.labelBBs then table.insert(e.labelBBs, bb) end
			end
		end
	end
end

local function refreshAllEntries()
	for _, e in ipairs(ITEM_ENTRIES)     do applyEntry(e) end
	for _, e in ipairs(CURRENCY_ENTRIES) do applyEntry(e) end
	applyEntry(MONSTER_ENTRY)
end

-- ============================================================
--  MAP WATCHER
-- ============================================================
local function onMapArrived(child)
	task.wait(0.3)
	if not child or not child.Parent then return end
	currentMap = child
	local elapsed = 0
	repeat
		if not child.Parent or currentMap ~= child then return end
		refreshAllEntries(); task.wait(0.5); elapsed = elapsed + 0.5
	until elapsed >= 10
end

local function watchCurrentRoom()
	local cr = workspace:FindFirstChild("CurrentRoom") or workspace:WaitForChild("CurrentRoom", 30)
	if not cr then return end
	API.Track(cr.ChildAdded:Connect(function(child)
		if child:IsA("Model") then task.spawn(onMapArrived, child) end
	end))
	API.Track(cr.ChildRemoved:Connect(function()
		currentMap = nil
		for _, e in ipairs(ITEM_ENTRIES)     do clearEntry(e) end
		for _, e in ipairs(CURRENCY_ENTRIES) do clearEntry(e) end
		clearEntry(MONSTER_ENTRY)
	end))
	for _, child in ipairs(cr:GetChildren()) do
		if child:IsA("Model") then task.spawn(onMapArrived, child); break end
	end
end

-- ============================================================
--  PLAYER ESP
-- ============================================================
local localPlayer = Players.LocalPlayer
local playerESPOn = false
local playerData  = {}

local function getHealthColor(hp, maxHp)
	if maxHp >= 4 then
		if hp >= 4 then return Color3.fromRGB(100, 210, 255)
		elseif hp >= 3 then return Color3.fromRGB(40, 200, 80)
		elseif hp >= 2 then return Color3.fromRGB(255, 140, 0)
		else return Color3.fromRGB(220, 40, 40) end
	elseif maxHp == 3 then
		if hp >= 3 then return Color3.fromRGB(40, 200, 80)
		elseif hp >= 2 then return Color3.fromRGB(255, 140, 0)
		else return Color3.fromRGB(220, 40, 40) end
	else
		if hp >= 2 then return Color3.fromRGB(40, 200, 80)
		else return Color3.fromRGB(220, 40, 40) end
	end
end

local function getHearts(hp, maxHp)
	local full  = math.max(0, math.floor(hp))
	local empty = math.max(0, maxHp - full)
	return string.rep("❤️", full) .. string.rep("🖤", empty)
end

local function clearPlayerESP(p)
	local data = playerData[p]
	if data then
		if data.healthConn then data.healthConn:Disconnect() end
		pcall(function() data.highlight:Destroy() end)
		pcall(function() data.billboard:Destroy() end)
		playerData[p] = nil
	end
end

local function applyPlayerESP(p)
	if p == localPlayer then return end
	clearPlayerESP(p)
	if not playerESPOn then return end
	local char = p.Character;                            if not char then return end
	local hum  = char:FindFirstChildOfClass("Humanoid"); if not hum  then return end

	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1; hl.OutlineTransparency = 0
	hl.OutlineColor = getHealthColor(hum.Health, hum.MaxHealth)
	hl.Adornee = char; hl.Parent = hlFolder

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local bb  = Instance.new("BillboardGui")
	bb.Name = "ESP_PlayerLabel"; bb.Size = UDim2.new(0, 140, 0, 60)
	bb.StudsOffset = Vector3.new(0, 3.5, 0); bb.AlwaysOnTop = true
	bb.LightInfluence = 0; bb.Adornee = hrp or char:FindFirstChild("Head") or char
	bb.Parent = char

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder; layout.Padding = UDim.new(0, 1)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center; layout.Parent = bb

	local userLbl = Instance.new("TextLabel")
	userLbl.Size = UDim2.new(1, 0, 0, 14); userLbl.BackgroundTransparency = 1
	userLbl.Text = "@" .. p.Name; userLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
	userLbl.Font = Enum.Font.FredokaOne; userLbl.TextSize = 11
	userLbl.TextStrokeTransparency = 0; userLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	userLbl.LayoutOrder = 1; userLbl.Parent = bb

	local dispLbl = Instance.new("TextLabel")
	dispLbl.Size = UDim2.new(1, 0, 0, 22); dispLbl.BackgroundTransparency = 1
	dispLbl.Text = p.DisplayName; dispLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	dispLbl.Font = Enum.Font.FredokaOne; dispLbl.TextSize = 17
	dispLbl.TextStrokeTransparency = 0; dispLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	dispLbl.LayoutOrder = 2; dispLbl.Parent = bb

	local hpLbl = Instance.new("TextLabel")
	hpLbl.Size = UDim2.new(1, 0, 0, 18); hpLbl.BackgroundTransparency = 1
	hpLbl.Text = getHearts(hum.Health, hum.MaxHealth)
	hpLbl.TextColor3 = getHealthColor(hum.Health, hum.MaxHealth)
	hpLbl.Font = Enum.Font.FredokaOne; hpLbl.TextSize = 13
	hpLbl.TextStrokeTransparency = 0; hpLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	hpLbl.LayoutOrder = 3; hpLbl.Parent = bb

	local healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
		if not playerESPOn or not playerData[p] then return end
		local col = getHealthColor(hum.Health, hum.MaxHealth)
		hl.OutlineColor = col; hpLbl.TextColor3 = col
		hpLbl.Text = getHearts(hum.Health, hum.MaxHealth)
	end)

	playerData[p] = { highlight = hl, billboard = bb, healthConn = healthConn }
end

local function hookPlayer(p)
	API.Track(p.CharacterAdded:Connect(function()
		task.wait(0.5)
		applyPlayerESP(p)
	end))
end

-- connected once (the old version connected again on every toggle)
for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
API.Track(Players.PlayerAdded:Connect(hookPlayer))
API.Track(Players.PlayerRemoving:Connect(clearPlayerESP))

local function enablePlayerESP()
	playerESPOn = true
	for _, p in ipairs(Players:GetPlayers()) do applyPlayerESP(p) end
end

local function disablePlayerESP()
	playerESPOn = false
	for p in pairs(playerData) do clearPlayerESP(p) end
	playerData = {}
end

