local sectionCount = 0

local function makeHeader(txt, order)
	local f = Instance.new("Frame")
	f.Size                   = UDim2.new(1, -4, 0, 24)
	f.BackgroundTransparency = 1
	f.LayoutOrder            = order
	f.Parent                 = ScrollESP

	local accent = Instance.new("Frame")
	accent.Size             = UDim2.new(0, 3, 0, 14)
	accent.Position         = UDim2.new(0, 2, 0.5, -7)
	accent.BackgroundColor3 = ACCENT
	accent.BorderSizePixel  = 0
	accent.Parent           = f
	makeCorner(accent, 2)

	local lbl = Instance.new("TextLabel")
	lbl.Size                   = UDim2.new(1, -14, 1, 0)
	lbl.Position               = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text                   = txt
	lbl.TextColor3             = Color3.fromRGB(255, 205, 130)
	lbl.Font                   = Enum.Font.FredokaOne
	lbl.TextSize               = 12
	lbl.TextXAlignment         = Enum.TextXAlignment.Left
	lbl.Parent                 = f
	return f
end

local function makeGridContainer(order)
	local f = Instance.new("Frame")
	f.Size                   = UDim2.new(1, -4, 0, 0)
	f.AutomaticSize          = Enum.AutomaticSize.Y
	f.BackgroundTransparency = 1
	f.BorderSizePixel        = 0
	f.LayoutOrder            = order
	f.Parent                 = ScrollESP

	local grid = Instance.new("UIGridLayout")
	grid.CellSize    = UDim2.new(0.5, -4, 0, 52)
	grid.CellPadding = UDim2.new(0, 4, 0, 4)
	grid.SortOrder   = Enum.SortOrder.LayoutOrder
	grid.Parent      = f
	return f
end

local function beginSection(title, baseOrder)
	sectionCount = sectionCount + 1
	local idx  = sectionCount
	local hdr  = makeHeader("  " .. title, baseOrder)
	local grid = makeGridContainer(baseOrder + 1)
	sectionMeta[idx] = { headerFrame = hdr, gridFrame = grid }
	return grid, idx
end

