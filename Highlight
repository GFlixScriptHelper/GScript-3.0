local searchText  = ""
local filterMode  = 0     -- 0 = All | 1 = Enabled only | 2 = Disabled only
local allCards    = {}    -- { row, label, enabled, sectionIdx }
local sectionMeta = {}    -- [idx] = { headerFrame, gridFrame }

local function refreshVisibility()
	local sectionHasVisible = {}
	for _, card in ipairs(allCards) do
		local matchSearch = searchText == ""
			or card.label:lower():find(searchText:lower(), 1, true)
		local matchFilter = filterMode == 0
			or (filterMode == 1 and card.enabled)
			or (filterMode == 2 and not card.enabled)
		card.row.Visible = (matchSearch and matchFilter) and true or false
		if matchSearch and matchFilter then
			sectionHasVisible[card.sectionIdx] = true
		end
	end
	for idx, meta in ipairs(sectionMeta) do
		local show = sectionHasVisible[idx] == true
		meta.headerFrame.Visible = show
		meta.gridFrame.Visible   = show
	end
end

