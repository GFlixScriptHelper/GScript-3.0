local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function makeToggleCard(parent, labelTxt, pillColor, sectionIdx, onToggle)
	local row = Instance.new("Frame")
	row.BackgroundColor3 = CARD
	row.BorderSizePixel  = 0
	row.Size             = UDim2.new(1, 0, 1, 0)
	row.Parent           = parent
	makeCorner(row, 8)
	makeStroke(row, STROKE, 1, 0)

	local pill = Instance.new("Frame")
	pill.Size             = UDim2.new(0, 4, 0, 18)
	pill.Position         = UDim2.new(0, 6, 0.5, -9)
	pill.BackgroundColor3 = pillColor
	pill.BorderSizePixel  = 0
	pill.Parent           = row
	makeCorner(pill, 3)

	local swBg = Instance.new("TextButton")
	swBg.Size             = UDim2.new(0, 36, 0, 18)
	swBg.Position         = UDim2.new(1, -42, 0.5, -9)
	swBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	swBg.BorderSizePixel  = 0
	swBg.Text             = ""
	swBg.AutoButtonColor  = false
	swBg.Parent           = row
	makeCorner(swBg, 9)
	makeStroke(swBg, STROKE, 1, 0)

	local knob = Instance.new("Frame")
	knob.Size             = UDim2.new(0, 12, 0, 12)
	knob.Position         = UDim2.new(0, 3, 0.5, -6)
	knob.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
	knob.BorderSizePixel  = 0
	knob.Parent           = swBg
	makeCorner(knob, 6)

	local lbl = Instance.new("TextLabel")
	lbl.Size                   = UDim2.new(1, -58, 1, 0)
	lbl.Position               = UDim2.new(0, 16, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text                   = labelTxt
	lbl.TextColor3             = TEXT
	lbl.Font                   = Enum.Font.FredokaOne
	lbl.TextSize               = 12
	lbl.TextXAlignment         = Enum.TextXAlignment.Left
	lbl.TextWrapped            = true
	lbl.Parent                 = row

	local enabled   = false
	local cardEntry = { row = row, label = labelTxt, enabled = false, sectionIdx = sectionIdx }
	table.insert(allCards, cardEntry)

	local function refresh()
		if enabled then
			TweenService:Create(swBg, tweenInfo, { BackgroundColor3 = ACCENT }):Play()
			TweenService:Create(knob, tweenInfo, { Position = UDim2.new(0, 21, 0.5, -6), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }):Play()
			TweenService:Create(row,  tweenInfo, { BackgroundColor3 = CARD_ON }):Play()
		else
			TweenService:Create(swBg, tweenInfo, { BackgroundColor3 = Color3.fromRGB(50, 50, 50) }):Play()
			TweenService:Create(knob, tweenInfo, { Position = UDim2.new(0, 3, 0.5, -6), BackgroundColor3 = Color3.fromRGB(150, 150, 150) }):Play()
			TweenService:Create(row,  tweenInfo, { BackgroundColor3 = CARD }):Play()
		end
	end

	swBg.MouseButton1Click:Connect(function()
		enabled           = not enabled
		cardEntry.enabled = enabled
		refresh()
		onToggle(enabled, pill)
		if filterMode ~= 0 then refreshVisibility() end
	end)

	refresh()
	return row, pill
end

