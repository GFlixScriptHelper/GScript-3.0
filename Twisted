local function sendChat(msg)
	local ok = pcall(function()
		local events = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
		if not events then error("no legacy chat") end
		local say = events:FindFirstChild("SayMessageRequest")
		if not say then error("no legacy chat") end
		say:FireServer(msg, "All")
	end)
	if ok then return end
	pcall(function()
		local channel = game:GetService("TextChatService").TextChannels:WaitForChild("RBXGeneral", 1)
		if channel then channel:SendAsync(msg) end
	end)
end

local function chatList(kind, label)
	local names = monstersOfKind(kind)
	if #names == 0 then
		sendChat("No " .. label .. " Twisteds in the Map.")
	else
		sendChat("Theres " .. table.concat(names, ", ") .. " In the Map!")
	end
end

