		local cardStroke = stroke(card, hpColor, 1.5)

		local image = make("ImageLabel", {
			Position = UDim2.new(0.083, 0, 0.04, 0),
			Size = UDim2.new(0.833, 0, 0.5, 0),
			BackgroundColor3 = Color3.fromRGB(10, 10, 18),
			BorderSizePixel = 0,
			ZIndex = 10,
			Image = "rbxassetid://" .. headshotId,
			ScaleType = Enum.ScaleType.Fit,
		}, card)
		corner(image, 4)

		makeCardLabel({
			Position = UDim2.new(0, 1, 0.55, 0), Size = UDim2.new(1, -2, 0.15, 0),
			TextColor3 = Color3.fromRGB(180, 220, 255), TextStrokeTransparency = 0.5,
			Text = charName, MaxTextSize = 8,
		}, card)

		makeCardLabel({
			Position = UDim2.new(0, 1, 0.70, 0), Size = UDim2.new(1, -2, 0.13, 0),
			TextColor3 = Color3.fromRGB(160, 160, 200), TextStrokeTransparency = 0.7,
			Text = "@" .. displayName, MaxTextSize = 7,
		}, card)

		local hearts = math.max(0, math.floor(hp))
		local hpLabel = makeCardLabel({
			Position = UDim2.new(0, 1, 0.83, 0), Size = UDim2.new(1, -2, 0.15, 0),
			TextColor3 = hpColor, TextStrokeTransparency = 1,
			Text = string.rep("♥", hearts) .. string.rep("♡", math.max(0, maxHp - hearts)),
			MaxTextSize = 8,
		}, card)

		local function animateDeath()
			TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = Color3.fromRGB(5, 5, 5),
			}):Play()
			TweenService:Create(image, TweenInfo.new(0.4), {
				ImageTransparency = 1,
				BackgroundColor3 = Color3.fromRGB(5, 5, 5),
			}):Play()
			task.delay(0.5, function()
				pcall(function() card:Destroy() end)
			end)
		end

		if hum then
			table.insert(playerHpConnections, hum:GetPropertyChangedSignal("Health"):Connect(function()
				if hum.Health <= 0 then
					pcall(animateDeath)
					return
				end
				local color = getHealthColor(hum.Health, hum.MaxHealth)
				local full = math.max(0, math.floor(hum.Health))
				pcall(function()
					cardStroke.Color = color
					hpLabel.TextColor3 = color
					hpLabel.Text = string.rep("♥", full) .. string.rep("♡", math.max(0, hum.MaxHealth - full))
					cardGradient.Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, color),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 14, 22)),
					})
				end)
			end))
		end

		model.AncestryChanged:Connect(function(_, parent)
			if parent == nil then pcall(animateDeath) end
		end)

		local clickButton = make("TextButton", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 20,
			AutoButtonColor = false,
