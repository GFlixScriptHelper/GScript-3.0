-- ============================================================
local currentMap = nil

local function getMap()
	if currentMap and currentMap.Parent then
		return currentMap
	end
	return nil
end

local function countItems(match)
	local map = getMap()
	if not map then return 0 end
	local folder = map:FindFirstChild("Items")
	if not folder then return 0 end
	local count = 0
	for _, obj in ipairs(folder:GetChildren()) do
		if obj.Name:lower():find(match:lower()) then
			count = count + 1
		end
	end
	return count
end

-- names of the monsters in the map that have the given kind ("main" / "event")
local function monstersOfKind(kind)
	local names = {}
	local map = getMap()
	local folder = map and map:FindFirstChild("Monsters")
	if folder then
		for _, obj in ipairs(folder:GetChildren()) do
			local display, _, k = describe(obj.Name)
			if k == kind then
				table.insert(names, display)
			end
		end
	end
	return names
end

