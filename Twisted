local function getToonHeadshot(charName)
	if not charName or charName == "" then return FALLBACK_ID end
	if TOON_HEADSHOTS[charName] then return TOON_HEADSHOTS[charName] end
	local lower = charName:lower()
	for name, id in pairs(TOON_HEADSHOTS) do
		if lower:find(name:lower(), 1, true) then return id end
	end
	return FALLBACK_ID
end

local function getPlayerCharName(playerModel)
	local config = playerModel:FindFirstChild("Config")
	local nameValue = config and config:FindFirstChild("CharacterName")
	if not nameValue or nameValue.Value == "" then return "Unknown" end
	return nameValue.Value
end

local function getHealthColor(hp, maxHp)
	if maxHp <= 0 or hp <= 0 then return Color3.fromRGB(10, 10, 10) end -- dead
	if maxHp >= 4 then
		if hp >= 4 then return Color3.fromRGB(60, 160, 220)      -- light blue
		elseif hp >= 3 then return Color3.fromRGB(30, 130, 50)   -- green
		else return Color3.fromRGB(180, 40, 40) end              -- red
	elseif maxHp == 3 then
		if hp >= 3 then return Color3.fromRGB(30, 130, 50)
		elseif hp >= 2 then return Color3.fromRGB(200, 170, 20)  -- yellow
		else return Color3.fromRGB(180, 40, 40) end
	else
		if hp >= 2 then return Color3.fromRGB(30, 130, 50)
		else return Color3.fromRGB(180, 40, 40) end
	end
end

