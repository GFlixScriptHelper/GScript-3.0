-- ============================================================
--  NOTIFYLATEST  (spawn notification at the bottom of the screen)
--
--  Sequence:
--    1. NotifyLatest moves UP to its main position
--    2. slots 1..N (N = how many Twisteds spawned, max 8) come in one after
--       another: each image fades in while moving LEFT to its main position
--    3. wait 3 seconds
--    4. NotifyLatest moves DOWN to hide
-- ============================================================
local SLOT_COUNT   = 8
local NOTIFY_W     = 630   -- reference size in pixels (scaled to the screen when shown)
local BAR_H        = 36
local IMG_W        = 92
local IMG_H        = 104
local TUCK         = 8     -- how far the images tuck behind the bar
local NOTIFY_H     = IMG_H + BAR_H - TUCK
local SLOT_STEP    = (NOTIFY_W - IMG_W) / (SLOT_COUNT - 1)
local SLIDE        = 46    -- how far right the images start before moving left
local IMG_BOTTOM   = (NOTIFY_H - BAR_H + TUCK) / NOTIFY_H -- image bottom edge (scale Y)

local BATCH_WINDOW = 0.6   -- Twisteds spawning within this time share one notification
local HOLD_TIME    = 3     -- seconds to stay on screen once all images are in

local notifyHolder = make("Frame", {
	Name = "NotifyLatest",
	AnchorPoint = Vector2.new(0.5, 1),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ZIndex = 7,
