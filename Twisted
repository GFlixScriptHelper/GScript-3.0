local function countMatching(pattern)
	local map = getMap()
	local folder = map and map:FindFirstChild("Items")
	if not folder then return 0 end
	local count = 0
	for _, obj in ipairs(folder:GetChildren()) do
		if obj.Name:match(pattern) then count = count + 1 end
	end
	return count
end

