			TweenService:Create(card, TweenInfo.new(0.15), {
				BackgroundColor3 = tracked and Color3.fromRGB(20, 50, 80) or hpColor,
			}):Play()
			buildTrackerUI(model, headshotId, charName)
		end)
	end
