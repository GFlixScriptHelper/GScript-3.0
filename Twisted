local function findEntry(objName)
	local lower = objName:lower()
	for _, entry in ipairs(TWISTEDS) do
		for _, key in ipairs(entry.keys) do
			if lower:find(key, 1, true) then
				return entry
			end
		end
	end
	return nil
end

-- returns displayName ("Twisted X"), headshotId, kind
local function describe(objName)
	local entry = findEntry(objName)
	if entry then
		return "Twisted " .. entry.name, entry.id, entry.kind
	end
	local clean = objName:gsub("[Mm]onster", ""):gsub("^%s+", ""):gsub("%s+$", "")
	return "Twisted " .. clean, FALLBACK_ID, nil
end

