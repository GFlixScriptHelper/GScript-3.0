local notifyEnabled = false
local notifyToken = 0       -- changes whenever a running notification must stop
local notified = {}         -- [monster object] = true, so a monster only notifies once
local pending = {}          -- monsters waiting for the current batch window to end
local batchWaiting = false
local queue = {}            -- batches waiting to be shown
local showing = false

local function notifyScale()
	local width = GUI.AbsoluteSize.X
	if width <= 0 then width = 1588 end
	return math.clamp(width / 1588, 0.5, 1.4)
end

local function hideNotifyNow()
	notifyToken = notifyToken + 1
	if notifyHolder.Visible then
		local s = notifyScale()
		local tween = TweenService:Create(notifyHolder, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, 0, 1, NOTIFY_H * s + 30),
		})
		tween:Play()
		task.delay(0.3, function()
			if notifyToken and not showing then
				notifyHolder.Visible = false
			end
		end)
	end
end

local function playNotification(batch)
	local token = notifyToken
	local function alive()
		return token == notifyToken and notifyEnabled and notifyHolder.Parent ~= nil
	end

	-- only the monsters that are still in the map
	local names, ids = {}, {}
	for _, obj in ipairs(batch) do
		if obj.Parent then
			local display, id = describe(obj.Name)
			table.insert(names, (display:gsub("Twisted ", "")):upper())
			table.insert(ids, id)
		end
	end
	local count = #names
	if count == 0 then return end

	-- message
	local message
	if count == 1 then
		message = names[1] .. " SPAWNED!"
	elseif count <= 3 then
		message = table.concat(names, ", ") .. " SPAWNED!"
	else
		message = names[1] .. ", " .. names[2] .. ", " .. names[3] .. " & " .. (count - 3) .. " MORE SPAWNED!"
	end
	notifyText.Text = message

	-- size for this screen + start hidden below the screen
	local s = notifyScale()
	notifyHolder.Size = UDim2.fromOffset(NOTIFY_W * s, NOTIFY_H * s)
	local shownPos = UDim2.new(0.5, 0, 1, -6)
	local hiddenPos = UDim2.new(0.5, 0, 1, NOTIFY_H * s + 30)
	notifyHolder.Position = hiddenPos

	-- images: the group is centered, each starts SLIDE px to the right and invisible
	local groupW = (count - 1) * SLOT_STEP + IMG_W
	local startX = (NOTIFY_W - groupW) / 2
	local mainX = {}
	for i = 1, SLOT_COUNT do
		local slot = notifySlots[i]
		if i <= count then
			mainX[i] = (startX + (i - 1) * SLOT_STEP) / NOTIFY_W
			slot.Image = "rbxassetid://" .. ids[i]
			slot.ImageTransparency = 1
			slot.Position = UDim2.new(mainX[i] + SLIDE / NOTIFY_W, 0, IMG_BOTTOM, 0)
			slot.Visible = true
		else
			slot.Visible = false
		end
	end
	notifyHolder.Visible = true

	-- 1) NotifyLatest moves up to its main position
	TweenService:Create(notifyHolder, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = shownPos,
	}):Play()
	task.wait(0.5)
	if not alive() then return end

	-- 2) images 1..N: fade in while moving left to their main position
	for i = 1, count do
		TweenService:Create(notifySlots[i], TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			ImageTransparency = 0,
			Position = UDim2.new(mainX[i], 0, IMG_BOTTOM, 0),
		}):Play()
		task.wait(0.12)
		if not alive() then return end
	end
	task.wait(0.35) -- let the last image finish

	-- 3) wait 3 seconds
	task.wait(HOLD_TIME)
	if not alive() then return end

	-- 4) NotifyLatest moves down to hide
	TweenService:Create(notifyHolder, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = hiddenPos,
	}):Play()
	task.wait(0.45)
end

local function processQueue()
	if showing then return end
	showing = true
	task.spawn(function()
		while #queue > 0 and notifyEnabled do
			local batch = table.remove(queue, 1)
			playNotification(batch)
			task.wait(0.15)
		end
		showing = false
		if not notifyEnabled or #queue == 0 then
			notifyHolder.Visible = false
		end
	end)
end

-- a monster spawned: collect everything spawning close together into one batch
local function queueMonster(obj)
	if notified[obj] then return end
	notified[obj] = true
	table.insert(pending, obj)
	if batchWaiting then return end
	batchWaiting = true
	task.delay(BATCH_WINDOW, function()
		batchWaiting = false
		local all = pending
		pending = {}
		-- max 8 images per notification, extra Twisteds get their own one
		for first = 1, #all, SLOT_COUNT do
			local batch = {}
			for i = first, math.min(first + SLOT_COUNT - 1, #all) do
				table.insert(batch, all[i])
			end
			table.insert(queue, batch)
		end
		if notifyEnabled then
			processQueue()
		end
	end)
end

local function queueCurrentMonsters()
	local map = getMap()
	local folder = map and map:FindFirstChild("Monsters")
	if not folder then return end
	for _, obj in ipairs(folder:GetChildren()) do
		queueMonster(obj)
	end
end

local monstersConnection = nil

local function watchMonsters(map)
	if monstersConnection then
		monstersConnection:Disconnect()
		monstersConnection = nil
	end
	notified = {}
	pending = {}
	queue = {}

	task.spawn(function()
		local folder = map:FindFirstChild("Monsters") or map:WaitForChild("Monsters", 15)
		if not folder or currentMap ~= map then return end
		monstersConnection = API.Track(folder.ChildAdded:Connect(function(child)
			if notifyEnabled then
				task.wait(0.2)
				queueMonster(child)
			end
		end))
		if notifyEnabled then
			queueCurrentMonsters()
		end
	end)
end

local function setupMapWatcher()
	local room = workspace:FindFirstChild("CurrentRoom") or workspace:WaitForChild("CurrentRoom", 30)
	if not room then return end

	for _, child in ipairs(room:GetChildren()) do
		if child:IsA("Model") then
			currentMap = child
			watchMonsters(child)
			break
		end
	end

	API.Track(room.ChildAdded:Connect(function(child)
		if child:IsA("Model") then
			task.wait(0.3)
			currentMap = child
			watchMonsters(child)
		end
	end))

	API.Track(room.ChildRemoved:Connect(function()
		currentMap = nil
		notified, pending, queue = {}, {}, {}
		hideNotifyNow()
	end))
end

