-- ---------- monster tracker (follows a monster on screen) ----------
local activeTrackers = {} -- { obj, frame, conn }

local function destroyTracker(entry)
	pcall(function() entry.frame:Destroy() end)
	pcall(function() entry.conn:Disconnect() end)
end

local function clearAllTrackers()
	for _, entry in ipairs(activeTrackers) do destroyTracker(entry) end
	activeTrackers = {}
end

local function buildTrackerUI(obj, headshotId, displayName)
	-- click again = stop tracking
	for i, entry in ipairs(activeTrackers) do
		if entry.obj == obj then
			destroyTracker(entry)
			table.remove(activeTrackers, i)
			return
		end
	end

	local camera = workspace.CurrentCamera
	local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
	local startX, startY = 0.5, 0.5
	if root and camera then
		local viewport = camera.ViewportSize
		local point = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 4, 0))
		startX = math.clamp(point.X / viewport.X, 0.05, 0.92)
		startY = math.clamp(point.Y / viewport.Y, 0.05, 0.88)
	end

	local tracker = make("Frame", {
		Name = "MonsterTracker",
		Size = UDim2.new(0, 76, 0, 86),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.fromRGB(14, 14, 22),
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 200,
		Position = UDim2.new(startX, 0, startY - 0.06, 0),
	}, GUI)
	corner(tracker, 8)
	stroke(tracker, Color3.fromRGB(100, 120, 255), 1.5)
	make("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 20, 36)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 12, 22)),
		}),
		Rotation = 90,
	}, tracker)

	local image = make("ImageLabel", {
		Size = UDim2.new(0, 58, 0, 58),
		Position = UDim2.new(0.5, -29, 0, 5),
		BackgroundColor3 = Color3.fromRGB(10, 10, 20),
		BorderSizePixel = 0,
		ZIndex = 201,
		Image = "rbxassetid://" .. headshotId,
		ScaleType = Enum.ScaleType.Fit,
	}, tracker)
	corner(image, 6)

	make("TextLabel", {
		Size = UDim2.new(1, -4, 0, 16),
		Position = UDim2.new(0, 2, 1, -18),
		BackgroundTransparency = 1,
		ZIndex = 201,
		Font = Enum.Font.FredokaOne,
		TextSize = 10,
		TextColor3 = Color3.fromRGB(220, 225, 255),
		TextStrokeTransparency = 0,
		TextWrapped = true,
		Text = (displayName:gsub("Twisted ", "")),
	}, tracker)

	make("TextLabel", {
		Size = UDim2.new(0, 20, 0, 14),
		Position = UDim2.new(0.5, -10, 1, 2),
		BackgroundTransparency = 1,
		ZIndex = 201,
		Font = Enum.Font.FredokaOne,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(100, 120, 255),
		Text = "▼",
	}, tracker)

	TweenService:Create(tracker, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(startX, 0, startY, 0),
	}):Play()

	local entry = { obj = obj, frame = tracker }
	entry.conn = RunService.Heartbeat:Connect(function()
		-- the monster is gone: remove the tracker
		if not obj or not obj.Parent then
			destroyTracker(entry)
			for i, e in ipairs(activeTrackers) do
				if e == entry then table.remove(activeTrackers, i); break end
			end
			return
		end
		local cam = workspace.CurrentCamera
		local r = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
		if not r or not cam then return end
		local viewport = cam.ViewportSize
		local point = cam:WorldToViewportPoint(r.Position + Vector3.new(0, 4, 0))
		tracker.Position = UDim2.new(
			math.clamp(point.X / viewport.X, 0.05, 0.92), 0,
			math.clamp(point.Y / viewport.Y, 0.05, 0.88), 0)
	end)
	table.insert(activeTrackers, entry)
end

