-- ============================================================
--  HEARTBEAT: animated detector borders + HUD refresh
-- ============================================================
local rainbowT, pinkT, lastRefresh = 0, 0, 0

API.Track(RunService.Heartbeat:Connect(function(dt)
	rainbowT = (rainbowT + dt * 1.5) % 1
	pinkT = (pinkT + dt * 1.2) % 1

	if #detectorRainbowStrokes > 0 then
		local color = Color3.fromHSV(rainbowT, 1, 1)
		for _, s in ipairs(detectorRainbowStrokes) do pcall(function() s.Color = color end) end
	end
	if #detectorPinkStrokes > 0 then
		local t = math.abs(math.sin(pinkT * math.pi))
		local color = Color3.fromRGB(255, 105, 180):Lerp(WHITE, t)
		for _, s in ipairs(detectorPinkStrokes) do pcall(function() s.Color = color end) end
	end

	lastRefresh = lastRefresh + dt
	if lastRefresh < 1.5 then return end
	lastRefresh = 0

	if infoHudVisible and latestHud and latestHud.Visible then
		if medkitAmountLbl then medkitAmountLbl.Text = tostring(countItems("HealthKit")) end
		if bandageAmountLbl then bandageAmountLbl.Text = tostring(countItems("Bandage")) end
		if twistedAmountLbl then twistedAmountLbl.Text = tostring(countMonsters()) end
		-- only rebuild the cards when the list of monsters / players changed
		if detectorMode == "monsters" then
			if monsterSignature() ~= lastMonsterSig then rebuildMonsterDetector() end
		elseif playerSignature() ~= lastPlayerSig then
			rebuildPlayerDetector()
		end
	end
end))

